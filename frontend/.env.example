# Development only. Omit in production so /api stays on the frontend origin.
VITE_API_BASE_URL=http://localhost:5000
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Server-only. Required in production when VITE_API_BASE_URL is omitted.
# Use the backend deployment origin only; do not include /api/v1 or a trailing path.
MAMLADIBE_API_ORIGIN=https://your-backend-project.vercel.app
